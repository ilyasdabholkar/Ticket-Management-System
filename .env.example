# Single environment file for the whole repo (git-ignored). Template: .env.example
# Vite exposes ONLY variables prefixed VITE_ to the browser; everything else stays server/local only.

# --- Browser (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional IIS virtual directory, e.g. /tms/ . Defaults to /
VITE_BASE_PATH=

# --- Secret: never prefix with VITE_, never commit ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=

# AI (OpenAI-compatible provider). The ai-assistant Edge Function reads these from
# Supabase Edge Function secrets; this file is only your local record of them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
